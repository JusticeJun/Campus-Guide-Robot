[Unit]
Description=Temporary HTTPS access to campus rover dashboard
Wants=campus-web.service
After=campus-web.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/bash %h/ros2_ws/src/apps/campus_mission/deploy/run_tunnel.sh
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=15
UMask=0077
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
