# Copy to ~/.config/campus-rover/mission.env; chmod 600. Never commit real keys.
OPENAI_API_KEY=
CAMPUS_LLM_MODEL=gpt-6.1-sol
CAMPUS_VLM_MODEL=gpt-6.1-sol
# Generated control-link capability. No login form; do not publish this key.
CAMPUS_WEB_TOKEN=
# Boot web and operator-triggered navigation share this map.
CAMPUS_MAP_DIR="$HOME/ros2_ws/maps/test_map/map1"
CAMPUS_WEB_HOST=0.0.0.0
CAMPUS_WEB_PORT=8080
CAMPUS_NAV_ODOMETRY=auto
CAMPUS_LIDAR_OBSTACLES=true
CAMPUS_RVIZ=false
